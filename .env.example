# Copy this file to .env (in this hw4/ folder) and fill in your own values.
# Never commit the real .env.

# Portkey gateway key used for all model calls (required for the chat assistant)
PORTKEY_API_KEY=your_portkey_api_key_here

# Model routed through Portkey (optional; this is the default)
MODEL_NAME=gpt-5.6-luna

# Set to true when the site is served over HTTPS so the login cookie is Secure
COOKIE_SECURE=false

# Optional: where the append-only agent audit log is written (default: output/audit_trail.json)
# AUDIT_TRAIL_PATH=output/audit_trail.json
